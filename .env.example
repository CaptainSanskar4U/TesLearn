GEMINI_API_KEY=
# OpenRouter (works without Gemini key) — get at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Best free default for text/HTML/JSON resources (262k context, structured output)
LLM_MODEL=openrouter/google/gemma-4-31b-it:free
LLM_FALLBACK=openrouter/nvidia/nemotron-3-super-120b-a12b:free
LIVE_MODEL=models/gemini-3.1-flash-live-preview
REPLICATE_API_TOKEN=r8_...
# must use gemini/ prefix (Google AI Studio API key). Without it LiteLLM uses Vertex.
LLM_MODEL=gemini/gemini-2.0-flash
IMAGE_MODEL=gemini/gemini-2.5-flash-image-preview
IMAGE_SIZE=1024x1024
VOICE_MALE=R8_71RSEH2W
VOICE_FEMALE=R8_GKYQ3UBG
VOICE_SPEED=R8_GKYQ3UBG
VOICE_ELON=R8_71RSEH2W
VOICE_ABDUL=R8_X6V884WQ
TTS_EMOTION=happy
TTS_MODEL=minimax/speech-02-turbo
BASE_URL=http://127.0.0.1:8000
